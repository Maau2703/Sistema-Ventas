@page
@model SistemaVentas.Areas.Identity.Pages.Account.LogoutModel

@{
    ViewData["Title"] = "Cerrar Sesión";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
</head>
<body class="bg-light">
    <div class="container mt-5">
        <div class="card shadow-sm">
            <div class="card-body text-center p-5">
                <h2 class="text-success"><i class="bi bi-check-circle"></i> Sesión cerrada</h2>
                <p class="text-muted mt-3">Gracias por usar Sistema de Ventas</p>
                <a asp-page="Login" class="btn btn-primary mt-3">
                    <i class="bi bi-box-arrow-in-right"></i> Volver a iniciar sesión
                </a>
            </div>
        </div>
    </div>
</body>
</html>