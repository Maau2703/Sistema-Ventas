@page
@model SistemaVentas.Areas.Identity.Pages.Account.LoginModel

@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SistemaVentas</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', sans-serif;
        }

        body {
            min-height: 100vh;
            overflow-x: hidden;
        }

        .login-wrapper {
            display: flex;
            min-height: 100vh;
        }

        /* ========== LADO IZQUIERDO (Crema) ========== */
        .login-left {
            flex: 1;
            background: #fef9e7;
            padding: 60px 80px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            position: relative;
        }

        .brand-header {
            display: flex;
            align-items: center;
            margin-bottom: 60px;
        }

        .brand-icon-box {
            width: 50px;
            height: 50px;
            background: linear-gradient(135deg, #4f46e5, #6366f1);
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 15px;
            box-shadow: 0 4px 15px rgba(79, 70, 229, 0.3);
        }

        .brand-icon-box i {
            font-size: 1.5rem;
            color: white;
        }

        .brand-header h3 {
            font-size: 1.4rem;
            font-weight: 700;
            color: #1f2937;
            margin: 0;
        }

        .welcome-label {
            font-size: 0.75rem;
            font-weight: 700;
            color: #6b7280;
            text-transform: uppercase;
            letter-spacing: 3px;
            margin-bottom: 15px;
        }

        .login-heading {
            font-size: 3rem;
            font-weight: 800;
            color: #1f2937;
            margin-bottom: 10px;
            line-height: 1.1;
        }

        .login-subheading {
            color: #9ca3af;
            font-size: 1rem;
            margin-bottom: 40px;
        }

        .form-label-custom {
            font-weight: 600;
            color: #374151;
            font-size: 0.95rem;
            margin-bottom: 10px;
        }

        .input-icon-wrapper {
            position: relative;
            margin-bottom: 20px;
        }

        .input-icon-wrapper i {
            position: absolute;
            left: 18px;
            top: 50%;
            transform: translateY(-50%);
            color: #9ca3af;
            font-size: 1.1rem;
            z-index: 2;
        }

        .input-icon-wrapper input {
            width: 100%;
            padding: 16px 18px 16px 50px;
            border: 2px solid #e5e7eb;
            border-radius: 12px;
            font-size: 1rem;
            background: white;
            transition: all 0.3s;
        }

        .input-icon-wrapper input:focus {
            outline: none;
            border-color: #4f46e5;
            box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.1);
        }

        .input-icon-wrapper input::placeholder {
            color: #d1d5db;
        }

        .password-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 10px;
        }

        .test-account {
            font-size: 0.8rem;
            color: #4f46e5;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
        }

        .test-account:hover {
            text-decoration: underline;
        }

        .checkbox-wrapper {
            display: flex;
            align-items: center;
            margin-bottom: 30px;
        }

        .checkbox-wrapper input[type="checkbox"] {
            width: 20px;
            height: 20px;
            margin-right: 10px;
            accent-color: #4f46e5;
            cursor: pointer;
        }

        .checkbox-wrapper label {
            color: #6b7280;
            font-size: 0.95rem;
            cursor: pointer;
            margin: 0;
        }

        .btn-submit {
            width: 100%;
            padding: 18px;
            background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%);
            color: white;
            border: none;
            border-radius: 14px;
            font-size: 1.1rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            box-shadow: 0 4px 15px rgba(79, 70, 229, 0.3);
        }

        .btn-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(79, 70, 229, 0.4);
        }

        .validation-summary-errors {
            background: #fee2e2;
            border: 1px solid #fecaca;
            color: #dc2626;
            padding: 15px 20px;
            border-radius: 12px;
            margin-bottom: 25px;
            font-size: 0.9rem;
        }

        /* ========== LADO DERECHO (Azul) ========== */
        .login-right {
            flex: 1;
            background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 50%, #3b82f6 100%);
            padding: 60px 80px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            position: relative;
            overflow: hidden;
            color: white;
        }

        .login-right::before {
            content: '';
            position: absolute;
            top: -100px;
            right: -100px;
            width: 400px;
            height: 400px;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 50%;
        }

        .login-right::after {
            content: '';
            position: absolute;
            bottom: -150px;
            left: -100px;
            width: 500px;
            height: 500px;
            background: rgba(255, 255, 255, 0.03);
            border-radius: 50%;
        }

        .badge-control {
            display: inline-flex;
            align-items: center;
            background: rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(10px);
            padding: 10px 20px;
            border-radius: 30px;
            font-size: 0.9rem;
            font-weight: 500;
            width: fit-content;
            margin-bottom: 40px;
            position: relative;
            z-index: 1;
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        .badge-control i {
            margin-right: 8px;
        }

        .right-heading {
            font-size: 3.5rem;
            font-weight: 800;
            line-height: 1.1;
            margin-bottom: 20px;
            position: relative;
            z-index: 1;
        }

        .right-subheading {
            font-size: 1.1rem;
            opacity: 0.85;
            line-height: 1.6;
            margin-bottom: 50px;
            position: relative;
            z-index: 1;
        }

        .stats-card {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(15px);
            border-radius: 20px;
            padding: 30px;
            border: 1px solid rgba(255, 255, 255, 0.15);
            position: relative;
            z-index: 1;
        }

        .stats-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
        }

        .stats-title {
            font-size: 0.85rem;
            opacity: 0.8;
            font-weight: 500;
        }

        .stats-menu {
            opacity: 0.6;
            cursor: pointer;
        }

        .stats-amount {
            font-size: 2.5rem;
            font-weight: 800;
            margin-bottom: 5px;
        }

        .stats-change {
            font-size: 0.85rem;
            color: #4ade80;
            margin-bottom: 25px;
            font-weight: 600;
        }

        .chart-container {
            display: flex;
            align-items: flex-end;
            gap: 8px;
            height: 120px;
            padding-top: 10px;
        }

        .chart-bar-wrapper {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            height: 100%;
            justify-content: flex-end;
        }

        .chart-bar {
            width: 100%;
            border-radius: 6px 6px 0 0;
            transition: all 0.3s;
        }

        .chart-bar:hover {
            opacity: 0.8;
            transform: scaleY(1.05);
        }

        .chart-label {
            font-size: 0.7rem;
            opacity: 0.6;
            margin-top: 8px;
        }
        /* Estilo para el botón de ojo */
        #togglePassword {
            position: absolute;
            right: 18px;
            top: 50%;
            transform: translateY(-50%);
            cursor: pointer;
            color: #9ca3af;
            font-size: 1.1rem;
            z-index: 3;
            transition: color 0.2s;
        }

        #togglePassword:hover {
            color: #4f46e5;
        }

        /* Ajuste del input para que el texto no se superponga con el ojo */
        .input-icon-wrapper input[type="password"],
        .input-icon-wrapper input[type="text"] {
            padding-right: 50px;
        }

       @@media (max-width: 992px) {
    .login-right {
        display: none;
    }
    .login-left {
        padding: 40px 20px;
    }
}
        }
    </style>
</head>
<body>
    <div class="login-wrapper">
        <!-- LADO IZQUIERDO -->
        <div class="login-left">
            <div class="brand-header">
                <div class="brand-icon-box">
                    <i class="bi bi-lock-fill"></i>
                </div>
                <h3>Sistema de Ventas</h3>
            </div>

            <div class="welcome-label">Bienvenido de nuevo</div>
            <h1 class="login-heading">Inicia sesión</h1>
            <p class="login-subheading">Ingresa para continuar con la gestión de tu negocio.</p>

            <form id="account" method="post">
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                <label class="form-label-custom">Usuario</label>
                <div class="input-icon-wrapper">
                    <i class="bi bi-person"></i>
                    <input asp-for="Input.Email" placeholder="admin" autocomplete="username" />
                </div>
                <span asp-validation-for="Input.Email" class="text-danger small"></span>

                <div class="password-header">
                    <label class="form-label-custom mb-0">Contraseña</label>
                    <a href="#" class="test-account" id="fillTest">Cuenta de prueba</a>
                </div>
                <div class="input-icon-wrapper">
                    <i class="bi bi-lock"></i>
                    <input asp-for="Input.Password" type="password" id="passwordInput" placeholder="admin123!" autocomplete="current-password" style="padding-right: 50px;" />
                    <i class="bi bi-eye" id="togglePassword" style="left: auto; right: 18px; cursor: pointer; z-index: 3;"></i>
                </div>
                <span asp-validation-for="Input.Password" class="text-danger small"></span>

                <div class="checkbox-wrapper">
                    <input asp-for="Input.RememberMe" type="checkbox" checked />
                    <label asp-for="Input.RememberMe">Mantener sesión iniciada</label>
                </div>

                <button type="submit" class="btn-submit">
                    Iniciar sesión <i class="bi bi-arrow-right"></i>
                </button>
            </form>
        </div>

        <!-- LADO DERECHO -->
        <div class="login-right">
            <div class="badge-control">
                <i class="bi bi-graph-up-arrow"></i>Todo bajo control
            </div>

            <h1 class="right-heading">Tu negocio,<br>en una sola vista.</h1>
            <p class="right-subheading">Ventas, inventario y reportes reunidos en una experiencia simple y clara.</p>

            <div class="stats-card">
                <div class="stats-header">
                    <span class="stats-title">Resumen de ventas</span>
                    <span class="stats-menu"><i class="bi bi-three-dots"></i></span>
                </div>
                <div class="stats-amount">Bs 12,840.50</div>
                <div class="stats-change">↑ 12.5%</div>

                <div class="chart-container">
                    <div class="chart-bar-wrapper">
                        <div class="chart-bar" style="height: 40%; background: linear-gradient(180deg, #60a5fa, #3b82f6);"></div>
                        <span class="chart-label">Lun</span>
                    </div>
                    <div class="chart-bar-wrapper">
                        <div class="chart-bar" style="height: 60%; background: linear-gradient(180deg, #60a5fa, #3b82f6);"></div>
                        <span class="chart-label">Mar</span>
                    </div>
                    <div class="chart-bar-wrapper">
                        <div class="chart-bar" style="height: 45%; background: linear-gradient(180deg, #60a5fa, #3b82f6);"></div>
                        <span class="chart-label">Mié</span>
                    </div>
                    <div class="chart-bar-wrapper">
                        <div class="chart-bar" style="height: 80%; background: linear-gradient(180deg, #34d399, #10b981);"></div>
                        <span class="chart-label">Jue</span>
                    </div>
                    <div class="chart-bar-wrapper">
                        <div class="chart-bar" style="height: 55%; background: linear-gradient(180deg, #60a5fa, #3b82f6);"></div>
                        <span class="chart-label">Vie</span>
                    </div>
                    <div class="chart-bar-wrapper">
                        <div class="chart-bar" style="height: 70%; background: linear-gradient(180deg, #60a5fa, #3b82f6);"></div>
                        <span class="chart-label">Sáb</span>
                    </div>
                    <div class="chart-bar-wrapper">
                        <div class="chart-bar" style="height: 90%; background: linear-gradient(180deg, #a78bfa, #8b5cf6);"></div>
                        <span class="chart-label">Dom</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Autocompletar con cuenta de prueba
        document.getElementById('fillTest').addEventListener('click', function(e) {
            e.preventDefault();
            document.querySelector('input[name="Input.Email"]').value = 'admin';
            document.querySelector('input[name="Input.Password"]').value = 'admin123!';
        });

        // Autocompletar al cargar si está vacío
        window.addEventListener('load', function() {
            const emailInput = document.querySelector('input[name="Input.Email"]');
            const passInput = document.querySelector('input[name="Input.Password"]');
            if (!emailInput.value) emailInput.value = 'admin';
            if (!passInput.value) passInput.value = 'admin123!';
        });
        // Toggle para mostrar/ocultar contraseña
        const togglePassword = document.getElementById('togglePassword');
        const passwordInput = document.getElementById('passwordInput');

        togglePassword.addEventListener('click', function() {
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                this.classList.remove('bi-eye');
                this.classList.add('bi-eye-slash');
            } else {
                passwordInput.type = 'password';
                this.classList.remove('bi-eye-slash');
                this.classList.add('bi-eye');
            }
        });

        // Autocompletar con cuenta de prueba
        document.getElementById('fillTest').addEventListener('click', function(e) {
            e.preventDefault();
            document.querySelector('input[name="Input.Email"]').value = 'admin';
            document.querySelector('input[name="Input.Password"]').value = 'admin123!';
        });

        // Autocompletar al cargar si está vacío
        window.addEventListener('load', function() {
            const emailInput = document.querySelector('input[name="Input.Email"]');
            const passInput = document.querySelector('input[name="Input.Password"]');
            if (!emailInput.value) emailInput.value = 'admin';
            if (!passInput.value) passInput.value = 'admin123!';
        });
    </script>
</body>
</html>