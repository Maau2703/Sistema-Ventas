@model List<Venta>

@{
    ViewData["Title"] = "Lista de Ventas";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Ventas</h2>
    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-circle"></i> Nueva Venta
    </a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Fecha</th>
            <th>Cliente</th>
            <th>Total</th>
            <th>Recibido</th>
            <th>Cambio</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@(item.Cliente?.Nombre ?? "Sin cliente")</td>
                <td>@item.Total.ToString("C")</td>
                <td>@item.Recibido.ToString("C")</td>
                <td>@item.Cambio.ToString("C")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Detalles</a>
                </td>
            </tr>
        }
    </tbody>
</table>