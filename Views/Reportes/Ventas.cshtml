@model List<SistemaVentas.Models.Venta>

@{
    ViewData["Title"] = "Reporte de Ventas";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-receipt"></i> Reporte de Ventas</h2>
    <div class="d-flex gap-2">
    
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Volver
        </a>
    </div>
</div>

<!-- Filtro de fechas -->
<div class="card mb-4">
    <div class="card-body">
        <form method="get" asp-action="Ventas" class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Desde</label>
                <input type="date" name="desde" value="@ViewBag.Desde.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Hasta</label>
                <input type="date" name="hasta" value="@ViewBag.Hasta.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-search"></i> Filtrar
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header bg-white">
        <div class="d-flex justify-content-between">
            <span>Período: @ViewBag.Desde.ToString("dd/MM/yyyy") al @ViewBag.Hasta.ToString("dd/MM/yyyy")</span>
            <strong class="text-primary">Total: Bs @ViewBag.Total.ToString("N2")</strong>
        </div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Fecha</th>
                        <th>Cliente</th>
                        <th class="text-end">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var v in Model)
                        {
                            <tr>
                                <td>#@v.Id</td>
                                <td>@v.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@(v.Cliente?.Nombre ?? "Sin cliente")</td>
                                <td class="text-end"><strong>Bs @v.Total.ToString("N2")</strong></td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">No hay ventas en este período</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>