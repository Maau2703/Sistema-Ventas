@model List<dynamic>

@{
    ViewData["Title"] = "Top 10 Productos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-trophy"></i> Top 10 Productos Más Vendidos</h2>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Volver
    </a>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-warning">
                    <tr>
                        <th>#</th>
                        <th>Producto</th>
                        <th class="text-center">Unidades Vendidas</th>
                        <th class="text-end">Total Vendido</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        int posicion = 1;
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @if (posicion == 1) { <i class="bi bi-trophy-fill text-warning"></i> }
                                    else if (posicion == 2) { <i class="bi bi-trophy-fill text-secondary"></i> }
                                    else if (posicion == 3) { <i class="bi bi-trophy-fill" style="color: #cd7f32;"></i> }
                                    else { @posicion }
                                </td>
                                <td><strong>@item.Nombre</strong></td>
                                <td class="text-center"><span class="badge bg-primary">@item.Cantidad</span></td>
                                <td class="text-end"><strong>Bs @item.Total.ToString("N2")</strong></td>
                            </tr>
                            posicion++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">Aún no hay ventas registradas</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>